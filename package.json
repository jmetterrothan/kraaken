  "bugs": {
    "url": "https://github.com/jmetterrothan/kraaken/issues"
  },
  "homepage": "https://github.com/jmetterrothan/kraaken#readme",
  "dependencies": {
    "axios": "^1.13.3",
    "body-parser": "^1.19.0",
    "classnames": "^2.2.6",
    "cors": "^2.8.5",
    "debounce": "^1.2.0",
    "express": "^4.17.1",
    "gl-matrix": "^3.2.1",
    "howler": "^2.1.3",
    "md5": "*",
    "pako": "^1.0.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reset-css": "^5.0.2",
