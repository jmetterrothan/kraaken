    "@types/md5": "*",
    "@types/pako": "^1.0.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/webgl2": "0.0.5",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^7.12.0",
    "prettier": "2.1.2",
    "sass": "^1.97.3",
    "stylelint": "^17.0.0",
