{
  "name": "kraaken",
  "version": "1.0.0",
  "description": "A framework for making 2D platformer games",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "vite --host",
    "build": "vite build",
    "start-local-server": "node local/server.js",
    "check": "tsc -p tsconfig.json --noEmit --skipLibCheck",
    "lint": "eslint ./src/**/*.ts{,x} --cache --max-warnings=0",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
